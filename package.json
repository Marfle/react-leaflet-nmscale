{
  "name": "@marfle/react-leaflet-nmscale",
  "version": "3.0.1",
  "description": "Nautical mile scale for react-leaflet",
  "main": "dist/esm/nmscale.js",
  "module": "dist/esm/nmscale.js",
  "sideEffects": false,
  "types": "dist/types/nmscale.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rm -Rf dist/",
    "build": "npm run build:esm && npm run build:types",
    "build:esm": "BABEL_ENV=es babel --extensions .tsx,.ts,.js src --out-dir dist/esm",
    "build:types": "tsc --emitDeclarationOnly",
    "vitest": "vitest run",
    "lint": "eslint",
    "test": "npm run lint && npm run vitest && npm run test:types",
    "test:types": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marfle/react-leaflet-nmscale.git"
  },
  "keywords": [
    "react-leaflet",
    "react-leaflet-v3",
    "react-leaflet-v4",
    "react",
    "leaflet",
    "nautical",
    "scale"
  ],
  "author": "Marfle",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Marfle/react-leaflet-nmscale/issues"
  },
  "homepage": "https://github.com/Marfle/react-leaflet-nmscale#readme",
  "files": [
    "dist/*"
  ],
  "peerDependencies": {
    "react-leaflet": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
